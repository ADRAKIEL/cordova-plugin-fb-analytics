<?xml version="1.0" encoding="UTF-8"?>
<plugin id="cordova-plugin-fb-analytics" version="1.3.8"
  xmlns="http://apache.org/cordova/ns/plugins/1.0"
  xmlns:android="http://schemas.android.com/apk/res/android">

  <name>FBAnalytics</name>
  <description>Modern Facebook App Events analytics plugin for Cordova/Ionic</description>
  <license>MIT</license>

  <js-module src="www/fb-analytics.js" name="FBAnalytics">
    <clobbers target="FBAnalytics" />
  </js-module>

  <platform name="ios">

    <config-file target="config.xml" parent="/*">
      <feature name="FBAnalytics">
        <param name="ios-package" value="FBAnalytics" />
      </feature>
    </config-file>

    <source-file src="src/ios/FBAnalytics.h" />
    <source-file src="src/ios/FBAnalytics.m" />
    <source-file src="src/ios/AppDelegate+FBAnalytics.h" />
    <source-file src="src/ios/AppDelegate+FBAnalytics.m" />

    <preference name="FACEBOOKAPPID" />
    <preference name="FACEBOOKCLIENTTOKEN" />
    <preference name="FACEBOOKDISPLAYNAME" />
    <preference name="FACEBOOKURLSCHEME" />
    <preference name="FACEBOOKPRIVACYPOLICYURL" />
    <preference name="FACEBOOKAUTOLOGAPPEVENTSENABLED" />
    <preference name="FACEBOOKADVERTISERIDCOLLECTIONENABLED" />

    <podspec>
      <config>
        <source url="https://github.com/CocoaPods/Specs.git" />
      </config>
      <pods use-frameworks="true">
        <pod name="FBSDKCoreKit" spec="~> 13.0" />
        <pod name="FBSDKLoginKit" spec="~> 13.0" />
        <pod name="FBSDKShareKit" spec="~> 13.0" />
      </pods>
    </podspec>

    <config-file target="*-Info.plist" parent="FacebookAppID">
      <string>$FACEBOOKAPPID</string>
    </config-file>

    <config-file target="*-Info.plist" parent="FacebookClientToken">
      <string>$FACEBOOKCLIENTTOKEN</string>
    </config-file>

    <config-file target="*-Info.plist" parent="FacebookDisplayName">
      <string>$FACEBOOKDISPLAYNAME</string>
    </config-file>

    <config-file target="*-Info.plist" parent="CFBundleURLTypes">
      <array>
        <dict>
          <key>CFBundleURLSchemes</key>
          <array>
            <string>$FACEBOOKURLSCHEME</string>
          </array>
        </dict>
      </array>
    </config-file>

    <config-file target="*-Info.plist" parent="LSApplicationQueriesSchemes">
      <array>
        <string>fbapi</string>
        <string>fb-messenger-api</string>
      </array>
    </config-file>

    <config-file target="*-Info.plist" parent="UIApplicationSceneManifest">
      <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
      </dict>
    </config-file>

    <config-file target="*-Info.plist" parent="SKAdNetworkItems">
      <array>
        <dict>
          <key>SKAdNetworkIdentifier</key>
          <string>cstr6suwn9.skadnetwork</string>
        </dict>
      </array>
    </config-file>

    <config-file target="*-Info.plist" parent="FacebookAutoLogAppEventsEnabled">
      <true/>
    </config-file>

    <config-file target="*-Info.plist" parent="FacebookAdvertiserIDCollectionEnabled">
      <true/>
    </config-file>

    <config-file target="*-Info.plist" parent="NSPrivacyPolicyURL">
      <string>$FACEBOOKPRIVACYPOLICYURL</string>
    </config-file>

  </platform>

  <platform name="android">

    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="FBAnalytics">
        <param name="android-package" value="com.fb.analytics.FBAnalytics" />
      </feature>
    </config-file>

    <source-file src="src/android/FBAnalytics.java" target-dir="src/com/fb/analytics/" />

    <framework src="com.facebook.android:facebook-android-sdk:16.0.0" />

    <preference name="FACEBOOKAPPID" />
    <preference name="FACEBOOKCLIENTTOKEN" />
    <preference name="FACEBOOKDISPLAYNAME" />
    <preference name="FACEBOOKPRIVACYPOLICYURL" />
    <preference name="FACEBOOKURLSCHEME" />

    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="$FACEBOOKAPPID" />
      <meta-data android:name="com.facebook.sdk.ClientToken" android:value="$FACEBOOKCLIENTTOKEN" />
    </config-file>

  </platform>

</plugin>
